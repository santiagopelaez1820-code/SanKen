# Esta línea sirve para definir la URL base de la API a la que se conecta la app móvil.
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- Reverb (retos en vivo, Sprint 10) — mismos valores que apps/api/.env ---
# Esta línea sirve para definir la clave de la aplicación Reverb para los eventos en vivo.
EXPO_PUBLIC_REVERB_APP_KEY=
# Esta línea sirve para definir el host del servidor Reverb.
EXPO_PUBLIC_REVERB_HOST=localhost
# Esta línea sirve para definir el puerto del servidor Reverb.
EXPO_PUBLIC_REVERB_PORT=8080
# Esta línea sirve para definir el esquema (http o https) del servidor Reverb.
EXPO_PUBLIC_REVERB_SCHEME=http

# --- Firebase (login social) — config pública del cliente, sacala de Firebase
# Console > Configuración del proyecto > Tus apps > app Web ---
# Esta línea sirve para definir la clave de API de Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
# Esta línea sirve para definir el dominio de autenticación de Firebase.
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Esta línea sirve para definir el id del proyecto de Firebase.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Esta línea sirve para definir el bucket de almacenamiento de Firebase.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Esta línea sirve para definir el id del remitente de mensajería de Firebase.
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Esta línea sirve para definir el id de la aplicación de Firebase.
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Sign-In nativo (Android/iOS) — "client_type": 3 dentro de
# google-services.json (Firebase Console > tu app Android > descargar) ---
# Esta línea sirve para definir el id de cliente web de Google para el inicio de sesión nativo.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
