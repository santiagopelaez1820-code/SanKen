# Esta línea sirve para definir el nombre de la aplicación.
APP_NAME=SanKen

# Esta línea sirve para definir el entorno (local).
APP_ENV=local
# Esta línea sirve para dejar vacía la clave de la app (se genera con php artisan key:generate).
APP_KEY=
# Esta línea sirve para activar el modo debug.
APP_DEBUG=true
# Esta línea sirve para definir la URL de la API.
APP_URL=http://localhost:8000

# Esta línea sirve para definir el idioma de la app.
APP_LOCALE=en
# Esta línea sirve para definir el idioma de respaldo.
APP_FALLBACK_LOCALE=en
# Esta línea sirve para definir el idioma de los datos falsos.
APP_FAKER_LOCALE=en_US

# Esta línea sirve para guardar el estado de mantenimiento en un archivo.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Esta línea sirve para definir los workers del servidor de desarrollo.
PHP_CLI_SERVER_WORKERS=4

# Esta línea sirve para definir las rondas de bcrypt para hashear contraseñas.
BCRYPT_ROUNDS=12

# Esta línea sirve para usar el canal de logs "stack".
LOG_CHANNEL=stack
# Esta línea sirve para escribir los logs en un solo archivo.
LOG_STACK=single
# Esta línea sirve para descartar los logs de funciones obsoletas.
LOG_DEPRECATIONS_CHANNEL=null
# Esta línea sirve para definir el nivel mínimo de log.
LOG_LEVEL=debug

# Esta línea sirve para usar MySQL como base de datos.
DB_CONNECTION=mysql
# Esta línea sirve para definir el host de la base de datos.
DB_HOST=127.0.0.1
# Esta línea sirve para definir el puerto de la base de datos.
DB_PORT=3306
# Esta línea sirve para definir el nombre de la base de datos.
DB_DATABASE=sanken
# Esta línea sirve para definir el usuario de la base de datos.
DB_USERNAME=sanken
# Esta línea sirve para definir la contraseña de la base de datos.
DB_PASSWORD=sanken

# Esta línea sirve para guardar las sesiones en Redis.
SESSION_DRIVER=redis
# Esta línea sirve para definir la duración de la sesión en minutos.
SESSION_LIFETIME=120
# Esta línea sirve para evitar cifrar la sesión.
SESSION_ENCRYPT=false
# Esta línea sirve para definir la ruta de la cookie.
SESSION_PATH=/
# Esta línea sirve para definir el dominio de la cookie.
SESSION_DOMAIN=null

# Esta línea sirve para usar Reverb para el tiempo real.
BROADCAST_CONNECTION=reverb
# Esta línea sirve para usar el disco local por defecto.
FILESYSTEM_DISK=local
# Esta línea sirve para usar Redis para la cola de trabajos.
QUEUE_CONNECTION=redis

# Esta línea sirve para usar Redis para la caché.
CACHE_STORE=redis
# CACHE_PREFIX=

# Esta línea sirve para definir el host de Memcached.
MEMCACHED_HOST=127.0.0.1

# Esta línea sirve para usar el cliente predis para Redis.
REDIS_CLIENT=predis
# Esta línea sirve para definir el host de Redis.
REDIS_HOST=127.0.0.1
# Esta línea sirve para definir la contraseña de Redis.
REDIS_PASSWORD=null
# Esta línea sirve para definir el puerto de Redis.
REDIS_PORT=6379

# Esta línea sirve para usar SMTP para enviar correos.
MAIL_MAILER=smtp
# Esta versión de Laravel resuelve el cifrado según MAIL_SCHEME, no
# MAIL_ENCRYPTION (esa variable ya no se lee) — dejar en null para que
# autodetecte STARTTLS según el puerto (correcto para Gmail en 587).
# Esta línea sirve para dejar que Laravel detecte el cifrado SMTP según el puerto.
MAIL_SCHEME=null
# Esta línea sirve para definir el servidor SMTP (Gmail).
MAIL_HOST=smtp.gmail.com
# Esta línea sirve para definir el puerto SMTP.
MAIL_PORT=587
# Esta línea sirve para definir el usuario SMTP.
MAIL_USERNAME=
# Esta línea sirve para definir la contraseña SMTP.
MAIL_PASSWORD=
# Esta línea sirve para definir el correo remitente.
MAIL_FROM_ADDRESS=
# Esta línea sirve para definir el nombre del remitente.
MAIL_FROM_NAME="${APP_NAME}"

# Esta línea sirve para definir la clave de acceso de AWS.
AWS_ACCESS_KEY_ID=
# Esta línea sirve para definir el secreto de AWS.
AWS_SECRET_ACCESS_KEY=
# Esta línea sirve para definir la región de AWS.
AWS_DEFAULT_REGION=us-east-1
# Esta línea sirve para definir el bucket de AWS.
AWS_BUCKET=
# Esta línea sirve para definir si se usan rutas de estilo path en AWS.
AWS_USE_PATH_STYLE_ENDPOINT=false

# Esta línea sirve para pasar el nombre de la app a Vite.
VITE_APP_NAME="${APP_NAME}"

# --- Sanctum / SPA ---
# Esta línea sirve para definir los dominios que usan autenticación por cookies.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Esta línea sirve para definir la URL del frontend web.
FRONTEND_URL=http://localhost:5173

# --- WhatsApp de atención (Fase 3, botón "Contactar con SanKen") ---
# Formato internacional sin '+' (ej. 573001234567). Vacío = el botón no aparece.
# Esta línea sirve para definir el número de WhatsApp de atención.
SUPPORT_WHATSAPP_NUMBER=

# --- Reverb (Laravel realtime) ---
# Esta línea sirve para definir el id de la app de Reverb.
REVERB_APP_ID=
# Esta línea sirve para definir la clave de la app de Reverb.
REVERB_APP_KEY=
# Esta línea sirve para definir el secreto de la app de Reverb.
REVERB_APP_SECRET=
# Esta línea sirve para definir el host de Reverb.
REVERB_HOST="localhost"
# Esta línea sirve para definir el puerto de Reverb.
REVERB_PORT=8080
# Esta línea sirve para definir el esquema de Reverb.
REVERB_SCHEME=http

# Esta línea sirve para pasar la clave de Reverb a Vite.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Esta línea sirve para pasar el host de Reverb a Vite.
VITE_REVERB_HOST="${REVERB_HOST}"
# Esta línea sirve para pasar el puerto de Reverb a Vite.
VITE_REVERB_PORT="${REVERB_PORT}"
# Esta línea sirve para pasar el esquema de Reverb a Vite.
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Web push (chat/notificaciones, Sprint 11) ---
# Generar con:
# php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# Esta línea sirve para definir la clave pública VAPID de Web Push.
VAPID_PUBLIC_KEY=
# Esta línea sirve para definir la clave privada VAPID de Web Push.
VAPID_PRIVATE_KEY=
# Esta línea sirve para definir el contacto del remitente de Web Push.
VAPID_SUBJECT=mailto:dev@sanken.app

# --- Login social (Google/Facebook vía Firebase) ---
# FIREBASE_CREDENTIALS = ruta absoluta a la service account JSON
# NUNCA commitear ese archivo.
# Esta línea sirve para definir el id del proyecto de Firebase.
FIREBASE_PROJECT_ID=
# Esta línea sirve para definir la ruta de la cuenta de servicio de Firebase.
FIREBASE_CREDENTIALS=

# --- Multimedia (avatares, Tienda, videos de ejercicios y PR) — ver docs/CLOUDINARY.md ---
# Toda subida va a Cloudinary si hay credenciales; MEDIA_STORAGE=local fuerza el disco public.
# Los valores reales van solo en el .env del servidor, nunca en git ni en las apps.
# Esta línea sirve para usar Cloudinary para guardar archivos.
MEDIA_STORAGE=cloudinary
# Esta línea sirve para definir el nombre de la cuenta de Cloudinary.
CLOUDINARY_CLOUD_NAME=
# Esta línea sirve para definir la API key de Cloudinary.
CLOUDINARY_API_KEY=
# Esta línea sirve para definir el API secret de Cloudinary.
CLOUDINARY_API_SECRET=
# Esta línea sirve para definir la carpeta raíz en Cloudinary.
CLOUDINARY_FOLDER=sanken