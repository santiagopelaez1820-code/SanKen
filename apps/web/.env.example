# Esta línea sirve para definir la URL base de la API a la que se conecta la web.
VITE_API_URL=http://localhost:8000

# --- Reverb (retos en vivo, Sprint 10) — mismos valores que apps/api/.env ---
# Esta línea sirve para definir la clave de la aplicación Reverb para los eventos en vivo.
VITE_REVERB_APP_KEY=
# Esta línea sirve para definir el host del servidor Reverb.
VITE_REVERB_HOST=localhost
# Esta línea sirve para definir el puerto del servidor Reverb.
VITE_REVERB_PORT=8080
# Esta línea sirve para definir el esquema (http o https) del servidor Reverb.
VITE_REVERB_SCHEME=http

# --- Web push (chat/notificaciones, Sprint 11) — misma clave pública que apps/api/.env ---
# Esta línea sirve para definir la clave pública VAPID para las notificaciones push web.
VITE_VAPID_PUBLIC_KEY=

# --- Firebase (login social — config pública del cliente, no es secreto) —
# mismos valores que apps/mobile/.env, mismo proyecto de Firebase. ---
# Esta línea sirve para definir la clave de API de Firebase.
VITE_FIREBASE_API_KEY=
# Esta línea sirve para definir el dominio de autenticación de Firebase.
VITE_FIREBASE_AUTH_DOMAIN=
# Esta línea sirve para definir el id del proyecto de Firebase.
VITE_FIREBASE_PROJECT_ID=
# Esta línea sirve para definir el bucket de almacenamiento de Firebase.
VITE_FIREBASE_STORAGE_BUCKET=
# Esta línea sirve para definir el id del remitente de mensajería de Firebase.
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Esta línea sirve para definir el id de la aplicación de Firebase.
VITE_FIREBASE_APP_ID=
