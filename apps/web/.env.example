VITE_API_URL=http://localhost:8000

# --- Reverb (retos en vivo, Sprint 10) — mismos valores que apps/api/.env ---
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- Web push (chat/notificaciones, Sprint 11) — misma clave pública que apps/api/.env ---
VITE_VAPID_PUBLIC_KEY=

# --- Firebase (login social — config pública del cliente, no es secreto) —
# mismos valores que apps/mobile/.env, mismo proyecto de Firebase. ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
